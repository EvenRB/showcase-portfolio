---
import PreviewArt from './PreviewArt.astro';

interface Props {
  image?: string;
  liveUrl?: string;
  screenshotUrl?: string;
  title: string;
  previewMood?: string;
  previewBase?: string;
  previewAccent?: string;
}
const { image, liveUrl, screenshotUrl: screenshotOverride, title, previewMood, previewBase = '#1a1a1a', previewAccent = '#888' } = Astro.props;

const initials = title
  .split(/\s+/)
  .slice(0, 2)
  .map(w => w[0]?.toUpperCase() ?? '')
  .join('');

const sourceUrl = screenshotOverride || liveUrl;
const screenshotUrl = sourceUrl
  ? `https://api.microlink.io/?url=${encodeURIComponent(sourceUrl)}&screenshot=true&meta=false&embed=screenshot.url`
  : null;
---

<div class="cc-wrap">
  {image ? (
    <img class="cc-img" src={image} alt={title} loading="lazy" />
  ) : screenshotUrl ? (
    <div class="cc-screenshot-wrap">
      <div class="cc-art-bg">
        <PreviewArt mood={previewMood || 'default'} base={previewBase} accent={previewAccent} />
      </div>
      <img
        class="cc-img cc-screenshot"
        src={screenshotUrl}
        alt={`${title} preview`}
        loading="lazy"
      />
    </div>
  ) : (
    <div class="cc-placeholder">
      <span class="cc-initials">{initials}</span>
    </div>
  )}
</div>
