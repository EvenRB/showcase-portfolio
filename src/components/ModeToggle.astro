---
// Light / Dark / Midnight Navy color mode picker.
// State lives on document.documentElement.dataset.mode + localStorage.
---
<div class="mode-toggle" role="radiogroup" aria-label="Color mode">
  <button type="button" class="mt-btn" data-mode="light" title="Light">
    <span class="mt-glyph" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
        <circle cx="8" cy="8" r="3" />
        <path d="M8 1.5v1.8M8 12.7v1.8M3.4 3.4l1.3 1.3M11.3 11.3l1.3 1.3M1.5 8h1.8M12.7 8h1.8M3.4 12.6l1.3-1.3M11.3 4.7l1.3-1.3" />
      </svg>
    </span>
    <span class="mt-label">Light</span>
  </button>
  <button type="button" class="mt-btn" data-mode="dark" title="Dark">
    <span class="mt-glyph" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor"><path d="M11.5 9.5a4.5 4.5 0 01-5-5A4.5 4.5 0 1011.5 9.5z" /></svg>
    </span>
    <span class="mt-label">Dark</span>
  </button>
  <button type="button" class="mt-btn" data-mode="navy" title="Midnight">
    <span class="mt-glyph" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.4">
        <circle cx="8" cy="8" r="5.2" />
        <path d="M8 2.8v10.4M2.8 8h10.4" />
      </svg>
    </span>
    <span class="mt-label">Midnight</span>
  </button>
</div>

<script>
  function syncActive(mode: string) {
    document.querySelectorAll<HTMLButtonElement>('.mode-toggle .mt-btn').forEach(b => {
      b.classList.toggle('is-active', b.dataset.mode === mode);
      b.setAttribute('aria-pressed', String(b.dataset.mode === mode));
    });
  }
  syncActive(document.documentElement.dataset.mode || 'light');

  document.querySelectorAll<HTMLButtonElement>('.mode-toggle .mt-btn').forEach(b => {
    b.addEventListener('click', () => {
      const m = b.dataset.mode!;
      document.documentElement.dataset.mode = m;
      try { localStorage.setItem('portfolio-mode', m); } catch {}
      syncActive(m);
    });
  });
</script>
