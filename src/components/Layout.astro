---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Even R Brekne — Portfolio', description = 'IT-Konsulent · projects, jobs, builds' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Restore color mode before first paint so we never flash the wrong theme -->
    <script is:inline>
      (function () {
        try {
          var m = localStorage.getItem('portfolio-mode') || 'light';
          document.documentElement.dataset.mode = m;
        } catch (_) {
          document.documentElement.dataset.mode = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <div id="vanta-bg" aria-hidden="true"></div>
    <div class="page theme-stone">
      <div class="page-inner">
        <slot />
      </div>
    </div>
    <script is:inline>
    (function () {
      var MODES = {
        light: { backgroundColor: 0xBDD5EE, skyColor: 0x7AAFD4, cloudColor: 0xEEF4FF, lightColor: 0xFFFFFF, speed: 0.50, backgroundAlpha: 1 },
        dark:  { backgroundColor: 0x050508, skyColor: 0x0D1520, cloudColor: 0x1A2840, lightColor: 0x506080, speed: 0.30, backgroundAlpha: 1 },
        navy:  { backgroundColor: 0x040C18, skyColor: 0x0A1E38, cloudColor: 0x1A3A60, lightColor: 0x4A80B8, speed: 0.40, backgroundAlpha: 1 },
      };
      var effect = null;
      function getMode() { return document.documentElement.dataset.mode || 'light'; }
      function initOrUpdate() {
        if (!window.VANTA || !window.VANTA.CLOUDS2) return;
        var cfg = MODES[getMode()] || MODES.light;
        if (effect) { effect.setOptions(cfg); }
        else {
          effect = window.VANTA.CLOUDS2({
            el: '#vanta-bg',
            mouseControls: true,
            touchControls: true,
            gyroControls: false,
            minHeight: 200,
            minWidth: 200,
            scale: 1.0,
            scaleMobile: 1.0,
            texturePath: '/noise.png',
            backgroundColor: cfg.backgroundColor,
            skyColor: cfg.skyColor,
            cloudColor: cfg.cloudColor,
            lightColor: cfg.lightColor,
            speed: cfg.speed,
            backgroundAlpha: cfg.backgroundAlpha,
          });
        }
      }
      function loadScript(src, cb) {
        var s = document.createElement('script');
        s.src = src;
        s.onload = cb;
        document.head.appendChild(s);
      }
      loadScript('/three.r134.min.js', function () {
        loadScript('/vanta.clouds2.min.js', initOrUpdate);
      });
      new MutationObserver(function (ms) {
        ms.forEach(function (m) { if (m.attributeName === 'data-mode') initOrUpdate(); });
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-mode'] });
    })();
    </script>
  </body>
</html>
