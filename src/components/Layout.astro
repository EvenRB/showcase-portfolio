---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Even R Brekne — Portfolio', description = 'IT-Konsulent · projects, jobs, builds' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Restore color mode before first paint so we never flash the wrong theme -->
    <script is:inline>
      (function () {
        try {
          var m = localStorage.getItem('portfolio-mode') || 'light';
          document.documentElement.dataset.mode = m;
        } catch (_) {
          document.documentElement.dataset.mode = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <div id="vanta-bg" aria-hidden="true"></div>
    <div class="page theme-stone">
      <div class="page-inner">
        <slot />
      </div>
    </div>
    <script is:inline>
    (function () {
      var MODES = {
        light: { backgroundColor: 0xFAF8F4, skyColor: 0xC2D0E8, cloudColor: 0xE5DDD0, lightColor: 0xFFFFFF, speed: 0.30, backgroundAlpha: 1 },
        dark:  { backgroundColor: 0x14110C, skyColor: 0x1E1A14, cloudColor: 0x2E2820, lightColor: 0x4A4036, speed: 0.20, backgroundAlpha: 1 },
        navy:  { backgroundColor: 0x0E1828, skyColor: 0x121E30, cloudColor: 0x1A2E4A, lightColor: 0x4A7AB8, speed: 0.25, backgroundAlpha: 1 },
      };
      var effect = null;
      function getMode() { return document.documentElement.dataset.mode || 'light'; }
      function initOrUpdate() {
        if (!window.VANTA || !window.VANTA.CLOUDS2) return;
        var cfg = MODES[getMode()] || MODES.light;
        if (effect) { effect.setOptions(cfg); }
        else {
          effect = window.VANTA.CLOUDS2({
            el: '#vanta-bg',
            mouseControls: true,
            touchControls: true,
            gyroControls: false,
            minHeight: 200,
            minWidth: 200,
            scale: 1.0,
            scaleMobile: 1.0,
            backgroundColor: cfg.backgroundColor,
            skyColor: cfg.skyColor,
            cloudColor: cfg.cloudColor,
            lightColor: cfg.lightColor,
            speed: cfg.speed,
            backgroundAlpha: cfg.backgroundAlpha,
          });
        }
      }
      function loadScript(src, cb) {
        var s = document.createElement('script');
        s.src = src;
        s.onload = cb;
        document.head.appendChild(s);
      }
      loadScript(
        'https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js',
        function () {
          loadScript(
            'https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.clouds2.min.js',
            initOrUpdate
          );
        }
      );
      new MutationObserver(function (ms) {
        ms.forEach(function (m) { if (m.attributeName === 'data-mode') initOrUpdate(); });
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-mode'] });
    })();
    </script>
  </body>
</html>
