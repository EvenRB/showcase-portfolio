---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Even R Brekne — Portfolio', description = 'IT-Konsulent · projects, jobs, builds' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <script is:inline>document.documentElement.dataset.mode = 'light';</script>
  </head>
  <body>
    <canvas id="blob-bg" aria-hidden="true"></canvas>
    <div class="page theme-stone">
      <div class="page-inner">
        <slot />
      </div>
    </div>
    <script is:inline>
    (function () {
      var canvas = document.getElementById('blob-bg');
      var ctx = canvas.getContext('2d');

      function resize() {
        canvas.width  = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      function getBlobColors() {
        var s = getComputedStyle(document.documentElement);
        return [1,2,3,4,5,6].map(function(i) { return s.getPropertyValue('--blob-'+i).trim(); });
      }

      var mouse = { x: window.innerWidth / 2, y: window.innerHeight / 2 };
      window.addEventListener('mousemove', function(e) { mouse.x = e.clientX; mouse.y = e.clientY; });

      var NUM = 6;
      var blobs = [];
      function initBlobs() {
        blobs = [];
        for (var i = 0; i < NUM; i++) {
          blobs.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height,
            r: 220 + Math.random() * 260,
            vx: (Math.random() - 0.5) * 0.4,
            vy: (Math.random() - 0.5) * 0.4,
            phase: Math.random() * Math.PI * 2,
            speed: 0.3 + Math.random() * 0.4,
          });
        }
      }
      initBlobs();

      var t = 0;
      var colors = getBlobColors();

      function frame() {
        t += 0.005;
        var W = canvas.width, H = canvas.height;
        ctx.clearRect(0, 0, W, H);

        // Find closest blob to mouse and gently attract it
        var minDist = Infinity, closest = null;
        for (var i = 0; i < blobs.length; i++) {
          var d = Math.hypot(blobs[i].x - mouse.x, blobs[i].y - mouse.y);
          if (d < minDist) { minDist = d; closest = blobs[i]; }
        }
        if (closest && minDist < 400) {
          var strength = 0.0012 * (1 - minDist / 400);
          closest.vx += (mouse.x - closest.x) * strength;
          closest.vy += (mouse.y - closest.y) * strength;
        }

        for (var i = 0; i < blobs.length; i++) {
          var b = blobs[i];
          b.vx += Math.sin(t * b.speed + b.phase) * 0.012;
          b.vy += Math.cos(t * b.speed + b.phase * 1.3) * 0.012;
          b.vx *= 0.98; b.vy *= 0.98;
          var spd = Math.hypot(b.vx, b.vy);
          if (spd > 1.2) { b.vx *= 1.2 / spd; b.vy *= 1.2 / spd; }
          b.x += b.vx; b.y += b.vy;
          if (b.x < -b.r) b.x = W + b.r;
          if (b.x > W + b.r) b.x = -b.r;
          if (b.y < -b.r) b.y = H + b.r;
          if (b.y > H + b.r) b.y = -b.r;

          var r = b.r * (1 + 0.08 * Math.sin(t * b.speed * 0.7 + b.phase));
          var g = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, r);
          var col = colors[i] || '#888';
          g.addColorStop(0,   col + 'BB');
          g.addColorStop(0.5, col + '44');
          g.addColorStop(1,   col + '00');
          ctx.beginPath();
          ctx.arc(b.x, b.y, r, 0, Math.PI * 2);
          ctx.fillStyle = g;
          ctx.fill();
        }

        requestAnimationFrame(frame);
      }
      frame();

      // Re-read blob colors when mode changes
      new MutationObserver(function(ms) {
        ms.forEach(function(m) {
          if (m.attributeName === 'data-mode') { colors = getBlobColors(); }
        });
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-mode'] });
    })();
    </script>
  </body>
</html>
