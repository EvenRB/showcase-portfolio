---
import StatusPulse from './StatusPulse.astro';
import LivePreview from './LivePreview.astro';
import type { Project } from '../lib/projects';

interface Props {
  p: Project;
  span?: 'sm' | 'lg';
}
const { p, span = 'sm' } = Astro.props;
const d = p.data;
const gh = p.gh;
const ratio = span === 'lg' ? '16 / 9' : '4 / 3';

const lang0 = gh?.languages?.[0];
---
<article class={`card cd span-${span}`}
  data-project-card
  data-status={d.status}
  data-type={d.type}
  data-tags={d.tags.join(',')}>
  <a class="card-link" href={`/projects/${p.id}/`}>
    <div class="cd-preview">
      <LivePreview
        liveUrl={d.url}
        repoUrl={d.repoUrl ?? (d.repo ? `https://github.com/${d.repo}` : undefined)}
        mood={d.previewMood}
        base={d.previewBase ?? '#1a1a1a'}
        accent={d.previewAccent ?? '#888'}
        ratio={ratio}
        title={d.title}
        id={p.id}
      />
    </div>
    <div class="cd-body">
      <h3 class="cd-title">
        {d.emoji && <span class="cd-emoji">{d.emoji}</span>}{d.title}
      </h3>
      {d.dateRange && <p class="cd-date mono">{d.dateRange}</p>}
      <div class="cd-foot">
        <span class="cd-status">
          <StatusPulse status={d.status} size={6} />
          <span class="cd-status-label">{d.status}</span>
        </span>
        {d.tags.map(t => <span class="cd-tag">{t}</span>)}
      </div>
      {(gh && (gh.stars > 0 || gh.languages.length > 0)) && (
        <div class="cd-techline mono">
          {lang0 && (
            <span class="cd-lang">
              <span class="lang-dot" style={`background: ${lang0.color}`}></span>
              {lang0.name}
            </span>
          )}
          {gh.stars > 0 && <span class="cd-stars">★ {gh.stars}</span>}
          <span class="cd-commit dim">{gh.commit}</span>
        </div>
      )}
    </div>
  </a>
</article>
